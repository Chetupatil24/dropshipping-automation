# Server Configuration
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dropshipping_db
DB_USER=postgres
DB_PASSWORD=your_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secret
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d

# Razorpay (Payment Gateway)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Shiprocket (Shipping)
SHIPROCKET_EMAIL=your_email@example.com
SHIPROCKET_PASSWORD=your_password
SHIPROCKET_API_URL=https://apiv2.shiprocket.in/v1/external

# Delhivery (Shipping Alternative)
DELHIVERY_API_KEY=your_delhivery_api_key
DELHIVERY_API_URL=https://track.delhivery.com/api

# Twilio (SMS & WhatsApp)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=your_twilio_number
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Email (SendGrid or SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@yourdropship.com

# Supplier APIs
ALIEXPRESS_API_KEY=your_aliexpress_key
ALIEXPRESS_API_SECRET=your_aliexpress_secret
CJ_DROPSHIP_API_KEY=your_cj_key
INDIAMART_API_KEY=your_indiamart_key

# Anthropic (AI Chatbot)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Frontend URLs
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Cloudflare (Optional)
CLOUDFLARE_API_KEY=your_cloudflare_key
CLOUDFLARE_ZONE_ID=your_zone_id
