{
  "name": "dropshipping-automation",
  "version": "1.0.0",
  "description": "Automated dropshipping platform with supplier integration, payment processing, and order automation",
  "main": "backend/server.js",
  "scripts": {
    "dev": "nodemon backend/server.js",
    "start": "node backend/server.js",
    "build:all": "cd frontend && npm run build && cd ../admin-dashboard && npm run build",
    "frontend": "cd frontend && npm run dev",
    "admin": "cd admin-dashboard && npm run dev",
    "jobs": "node backend/jobs/worker.js",
    "test": "jest",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "migrate": "node backend/database/migrate.js"
  },
  "keywords": [
    "dropshipping",
    "automation",
    "e-commerce"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.0",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "puppeteer": "^21.6.1",
    "razorpay": "^2.9.2",
    "redis": "^4.6.11",
    "sequelize": "^6.35.2",
    "twilio": "^4.19.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
