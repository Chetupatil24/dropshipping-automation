# Copy values into Railway environment variables (do NOT commit secrets to git)

# Database
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true

# Redis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# App
NODE_ENV=production
PORT=5000
JWT_SECRET=
JWT_EXPIRE=7d

# URLs
FRONTEND_URL=
ADMIN_URL=

# Payment (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shipping (Shiprocket)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Email
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASSWORD=

# Optional supplier API keys
ALIEXPRESS_API_KEY=
ALIEXPRESS_API_SECRET=
CJ_DROPSHIP_API_KEY=
CJ_DROPSHIP_EMAIL=
CJ_DROPSHIP_PASSWORD=
INDIAMART_API_KEY=
