# This file tells gcloud which files to skip when uploading source for Cloud Run builds.
# Syntax is identical to .gitignore

.gcloudignore
.git
.gitignore

# Local secrets
.env
.env.local
.env.railway
.env.*.local

# Node dependencies (re-installed during build)
node_modules/
frontend/node_modules/
admin-dashboard/node_modules/
backend/node_modules/

# Frontend build (not needed for backend Cloud Run image)
frontend/.next/
frontend/out/
admin-dashboard/.next/
admin-dashboard/out/

# Logs
logs/
*.log

# Dev artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db
coverage/

# Test files
**/*.test.js
**/*.spec.js
